# ══════════════════════════════════════════════════════════════════════
#  itirazvar — ortam değişkenleri
#  Lokal geliştirme için: `cp .env.example .env` ve doldur.
#  Prod (Coolify) için: bu değerleri Coolify "Environment Variables"a gir.
# ══════════════════════════════════════════════════════════════════════

# ─── Postgres (ZORUNLU) ──────────────────────────────────────────────
# Lokal: Docker'daki Postgres. Prod: Coolify'daki Postgres servisinin URL'i.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/itirazvar"

# ─── BetterAuth (ZORUNLU) ────────────────────────────────────────────
# SECRET'ı üret: openssl rand -base64 32   (prod'da MUTLAKA yeni üret!)
BETTER_AUTH_SECRET=""
# Uygulamanın public adresi (prod'da https://itirazvar.com).
BETTER_AUTH_URL="http://localhost:8080"
# İzinli origin'ler, virgülle. Prod'da domain'ini ekle: "https://itirazvar.com"
TRUSTED_ORIGINS="http://localhost:8080"

# ─── SEO / domain (ZORUNLU) ──────────────────────────────────────────
# Canonical URL, OG, sitemap, robots.txt bunu kullanır (prod: https://itirazvar.com).
SITE_URL="http://localhost:8080"
VITE_SITE_URL="http://localhost:8080"
# SSR sunucu-içi API çağrıları için. Prod'da konteynerin kendine erişimi:
#   http://localhost:3000  (PORT ile aynı). Boşsa SITE_URL kullanılır.
INTERNAL_API_URL="http://localhost:8080"
# Nitro node-server bu portu dinler (Coolify enjekte eder; lokalde build önizleme için).
PORT="3000"

# ─── Depolama / S3 (ZORUNLU — dosya/görsel yükleme) ──────────────────
# Lokal: MinIO. Prod: Coolify MinIO servisi veya Cloudflare R2 / AWS S3.
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="itirazvar"
S3_REGION="us-east-1"

# ─── Mail / OTP (PROD'DA ZORUNLU) ────────────────────────────────────
# Boşsa OTP kodları SUNUCU KONSOLUNA yazılır (sadece lokal geliştirme için).
# Prod'da gerçek e-posta doğrulaması için Resend API anahtarı gir.
RESEND_API_KEY=""
# Gönderen adresi. Domain Resend'de DOĞRULANMIŞ olmalı (yoksa 403).
# Doğrulanmamış domainle test için: "onboarding@resend.dev" (sadece kendi
# hesap mailine gönderir). Prod: kendi domainin.
EMAIL_FROM="itirazvar <noreply@itirazvarplus.com>"

# ─── Google OAuth (OPSİYONEL) ────────────────────────────────────────
# Etkinleştirmek için üçünü de doldur.
# Google Cloud Console → OAuth client → Authorized redirect URI:
#   https://itirazvar.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
VITE_GOOGLE_ENABLED="false"

# ─── Diğer ───────────────────────────────────────────────────────────
CRON_SECRET=""
