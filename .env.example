# ══════════════════════════════════════════════════════════════════════
#  tepkimvar — ortam değişkenleri
#  Lokal geliştirme için: `cp .env.example .env` ve doldur.
#  Prod (Coolify) için: bu değerleri Coolify "Environment Variables"a gir.
# ══════════════════════════════════════════════════════════════════════

# ─── Postgres (ZORUNLU) ──────────────────────────────────────────────
# Lokal: Docker'daki Postgres. Prod: Coolify'daki Postgres servisinin URL'i.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tepkimvar"

# ─── Prod (Coolify) kontrol listesi ─────────────────────────────────
# Coolify Environment Variables — https:// YAZ, :3000 YAZMA:
#   BETTER_AUTH_URL=https://tepkimvar.com
#   SITE_URL=https://tepkimvar.com
#   VITE_SITE_URL=https://tepkimvar.com   (build-time, redeploy gerekir)
#   TRUSTED_ORIGINS=https://tepkimvar.com,https://www.tepkimvar.com
#   INTERNAL_API_URL=http://localhost:3000
#   DOMAIN=tepkimvar.com
# Kod, env eksik olsa bile prod'da tepkimvar.com origin'ini kabul eder;
# yine de yukarıdakileri ayarlamak OAuth/cookie için önerilir.

# SECRET'ı üret: openssl rand -base64 32   (prod'da MUTLAKA yeni üret!)
BETTER_AUTH_SECRET=""
# Uygulamanın public adresi (prod'da https://tepkimvar.com).
BETTER_AUTH_URL="http://localhost:8080"
# İzinli origin'ler, virgülle. Prod örneği:
# TRUSTED_ORIGINS="https://tepkimvar.com,https://www.tepkimvar.com"
# BETTER_AUTH_URL ve SITE_URL otomatik trusted listesine eklenir.
TRUSTED_ORIGINS="http://localhost:8080"

# ─── SEO / domain (ZORUNLU) ──────────────────────────────────────────
# Canonical URL, OG, sitemap, robots.txt bunu kullanır (prod: https://tepkimvar.com).
SITE_URL="http://localhost:8080"
VITE_SITE_URL="http://localhost:8080"
# SSR sunucu-içi API çağrıları için. Prod'da konteynerin kendine erişimi:
#   http://localhost:3000  (PORT ile aynı). Boşsa SITE_URL kullanılır.
INTERNAL_API_URL="http://localhost:8080"
# Nitro node-server bu portu dinler (Coolify enjekte eder; lokalde build önizleme için).
PORT="3000"

# ─── Depolama / S3 (görsel yükleme) ──────────────────────────────────
# Seçenek A — MinIO/S3 (önerilen prod): üç değişken de dolu olmalı.
# Coolify'da MinIO stack + aynı Docker ağı (tepkimvar-internal):
#   S3_ENDPOINT=http://minio:9000
#   S3_ACCESS_KEY_ID=...
#   S3_SECRET_ACCESS_KEY=...
#   S3_BUCKET=itirazvar
#   S3_REGION=us-east-1
#
# Seçenek B — Yerel disk (MinIO yoksa otomatik): STORAGE_BACKEND=local
# Coolify → Persistent Storage → mount path: /app/data/storage
# STORAGE_BACKEND=local
# STORAGE_LOCAL_PATH=/app/data/storage
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Bucket adı marka değişikliğinde korundu: eski yüklenen görseller burada duruyor.
S3_BUCKET="itirazvar"
S3_REGION="us-east-1"
# STORAGE_BACKEND="local"
# STORAGE_LOCAL_PATH="/app/data/storage"

# ─── Mail / OTP (PROD'DA ZORUNLU) ────────────────────────────────────
# Boşsa OTP kodları SUNUCU KONSOLUNA yazılır (sadece lokal geliştirme için).
# Prod'da gerçek e-posta doğrulaması için Resend API anahtarı gir.
RESEND_API_KEY=""
# Gönderen adresi (Resend'de doğrulanmış domain). RESEND_FROM_EMAIL veya EMAIL_FROM.
RESEND_FROM_EMAIL=""
# Alternatif tam format: "tepkimvar <noreply@example.com>"
EMAIL_FROM="tepkimvar <noreply@tepkimvarplus.com>"

# ─── OAuth (Google / Facebook / Apple) ───────────────────────────────
# Sunucu env (runtime) + VITE_* (build-time, redeploy gerekir).
# Callback URI'ler:
#   https://tepkimvar.com/api/auth/callback/google
#   https://tepkimvar.com/api/auth/callback/facebook
#   https://tepkimvar.com/api/auth/callback/apple
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
VITE_OAUTH_GOOGLE="false"
VITE_GOOGLE_ENABLED="false"

FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
VITE_OAUTH_FACEBOOK="false"

# Apple: Services ID + JWT client secret (Better Auth docs)
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
APPLE_APP_BUNDLE_IDENTIFIER=""
VITE_OAUTH_APPLE="false"

# ─── AI / Complaint Bot (OPSİYONEL) ─────────────────────────────────
# Varsayılan: fal.ai üzerinden GPT-4o-mini (OpenRouter proxy).
# fal anahtarı fal.ai/dashboard/keys — uuid:secret formatı, AI_PROVIDER=fal
AI_PROVIDER="fal"
AI_API_KEY=""
# FAL_KEY=""   # AI_API_KEY yerine kullanılabilir
AI_BASE_URL="https://fal.run/openrouter/router/openai/v1"
AI_MODEL="openai/gpt-4o-mini"
# Doğrudan OpenRouter: AI_PROVIDER=openrouter  AI_API_KEY=sk-or-v1-...
#   AI_BASE_URL=https://openrouter.ai/api/v1
# Doğrudan OpenAI:     AI_PROVIDER=openai      AI_MODEL=gpt-4o-mini
AI_HTTP_REFERER=""
AI_APP_TITLE="tepkimvar"
# İstek timeout (ms) ve geçici hatalarda (429/5xx) yeniden deneme sayısı.
AI_TIMEOUT_MS="30000"
AI_MAX_RETRIES="2"
# "false" ise JSON mode kapatılır (eski modeller için).
AI_JSON_MODE="true"
# "true" ise bot şikayetleri herkese açık yayına çıkar VE marka puanına girer.
# Varsayılan kapalıdır — sentetik içerik gerçek ziyaretçiye gerçek şikayet gibi
# gösterilmez. Demo/staging için aç.
SYNTHETIC_CONTENT_PUBLIC="false"
# Çoklu marka bot çalıştırmasında eşzamanlı marka sayısı (varsayılan 3, max 8).
BOT_PARALLEL_BRANDS="3"

# ─── Diğer ───────────────────────────────────────────────────────────
# Coolify Scheduled Task / crontab bu sırrı Bearer olarak gönderir:
#   0 9 * * *  curl -fsS -X POST "$SITE_URL/api/cron/complaint-bot" \
#                -H "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=""
